CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_DESC_PRODUCT_STRING="ESP32 FIDO2 LAB ONLY"
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="DIY developer prototype"
# Sin Wi-Fi, Bluetooth, CDC ni DFU en el firmware de aplicación.
# ECC/CBOR need more space than the minimal main task stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
